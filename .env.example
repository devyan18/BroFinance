# ═══════════════════════════════════════════════════════════════════════════════
# Backend — Variables de entorno
# ─────────────────────────────────────────────────────────────────────────────
# Copiar a .env.local para desarrollo local:
#   cp .env.example .env.local
# Para producción (Render), configurar en el dashboard.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development

PORT=4000

# ── Base de datos ─────────────────────────────────────────────────────────────
# Local:      mongodb://localhost:27017/bro-finances
# Atlas:      mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>
MONGODB_URI=mongodb://localhost:27017/bro-finances

# ── Autenticación ─────────────────────────────────────────────────────────────
# Generá uno seguro: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia-esto-en-produccion

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local:      http://localhost:5173
# Producción: https://tu-app.netlify.app  (o tu dominio)
CORS_ORIGIN=http://localhost:5173

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Opcional — dejar vacío para deshabilitar login con Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudinary (avatares) ─────────────────────────────────────────────────────
# Obligatorio para subida de avatares
# Conseguirlos en: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (forgot-password) ───────────────────────────────────────────────────
# Opcional — necesario para que funcione "Olvidé mi contraseña"
# Gmail: activar App Password en Google Account → Security → 2-Step → App passwords
# Alternativamente: Resend (resend.com), Brevo (brevo.com), Mailgun, etc.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu@gmail.com
EMAIL_PASS=tu-app-password
EMAIL_FROM=tu@gmail.com

# FRONTEND_URL es OPCIONAL — si se omite, se usa el valor de CORS_ORIGIN
# Solo es necesario si el frontend está en un dominio distinto al CORS_ORIGIN
# FRONTEND_URL=https://tu-app.netlify.app

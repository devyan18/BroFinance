# Backend environment variables
# Copy to .env.local for local development: cp .env.example .env.local

# Node environment
NODE_ENV=development

# Server port
PORT=4000

# MongoDB connection URI
MONGODB_URI=mongodb://localhost:27017/bro-finances

# JWT secret — use a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Allowed CORS origin (frontend URL)
# - Development: http://localhost:5173
# - Production: https://yourdomain.com
CORS_ORIGIN=http://localhost:5173

# Google OAuth credentials (optional — leave empty to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
